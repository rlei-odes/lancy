# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Password to access the RAG Assistant UI (becomes the user password in Mode 2).
# Set either APP_PASSWORD (plaintext) or APP_PASSWORD_HASH (recommended).
# If both are set, APP_PASSWORD_HASH wins.
# Generate a hash with:  node scripts/hash-password.mjs 'your-secret-password'
APP_PASSWORD=your-secret-password
# APP_PASSWORD_HASH=pbkdf2$210000$…$…

# Optional: admin password for role separation (Mode 2).
# Can also be set via the Settings UI — which writes a hashed value to auth_config.json.
# Precedence for browser login: auth_config.json wins over these env vars if both are set.
# For API access (Bearer token): only these env vars are checked — auth_config.json is not
# readable in the Edge Runtime. If you need Bearer token admin access, set one of these.
# ADMIN_PASSWORD=your-admin-password
# ADMIN_PASSWORD_HASH=pbkdf2$210000$…$…

# Backend URL used server-side by the Next.js proxy (never reaches the browser)
BACKEND_URL=http://localhost:8080
